---
import '../styles/global.css'

const availableProducts = [
  {
    name: 'altivola-db',
    text: 'Aplikasi database gratis buat developer. Tinggal download, ada versi Mac dan Windows. Bisa dipakai bareng agent AI lewat MCP.',
    image: '/products/altivola-db.webp',
    imageAlt: 'Tampilan editor SQL dan hasil kueri di altivola-db',
    href: 'https://github.com/altivola/altivola-db#download',
    cta: 'Download gratis',
  },
  {
    name: 'Altivola Wedding',
    text: 'Bikin undangan nikah online dari pilihan desain, kirim link khusus buat tiap tamu, dan cek konfirmasi kehadiran dalam satu tempat.',
    image: '/products/altivola-wedding.webp',
    imageAlt: 'Contoh undangan Ruang Cetak di Altivola Wedding',
    href: 'https://wedding.altivola.workers.dev',
    cta: 'Buka website',
  },
]

const productIdeas = [
  {
    name: 'Tim AI',
    text: 'Satu tim AI lengkap, dari engineering, marketing, sampai finance. Ada koordinator yang bikin rencana, bagi tugas, dan ngecek hasilnya sampai beres.',
  },
  {
    name: 'Pantau aplikasi',
    text: 'Liat tiap request di aplikasi kamu jalan ke mana, mana yang lambat, mana yang error. Pasangnya gampang.',
  },
  {
    name: 'Template dashboard',
    text: 'Tampilan dashboard yang enak dilihat, warnanya hangat dan rapi. Tinggal pakai buat aplikasi kamu.',
  },
]

const title = 'Altivola: biar urusan digital kamu beres sendiri'
const description =
  'Studio software kecil dari Indonesia. Bikin alat digital yang gampang dipakai siapa aja: aplikasi database gratis, undangan nikah online, sampai tim AI.'

const field =
  'w-full rounded-xl border border-field bg-bg px-4 py-3.5 text-base text-fg placeholder:text-faint focus:border-accent focus:outline-none'
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
    />
  </head>
  <body class="font-sans antialiased">
    <div class="mx-auto max-w-[1120px] px-4 sm:px-6">
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line py-5">
        <a href="/" class="flex items-center gap-2.5 font-semibold">
          <span class="grid size-7 place-items-center rounded-[7px] bg-accent font-bold text-bg">a</span>
          Altivola
        </a>
        <div class="ml-auto flex flex-wrap gap-6 text-sm text-muted">
          <a href="#produk" class="hover:text-accent">Produk</a>
          <a href="#custom" class="hover:text-accent">Punya ide?</a>
          <a href="https://github.com/altivola" class="hover:text-accent">GitHub</a>
        </div>
      </nav>

      <section class="flex flex-col items-start gap-7 pt-20 pb-20 sm:pt-28 sm:pb-24">
        <h1
          class="max-w-[880px] font-display text-[clamp(40px,6vw,76px)] leading-[1.04] font-bold tracking-[-0.03em]"
        >
          Biar urusan digital kamu <span class="rounded-lg bg-accent px-2.5 text-bg">beres sendiri.</span>
        </h1>
        <p class="max-w-[620px] text-lg leading-relaxed text-muted sm:text-[19px]">
          Studio software kecil dari Indonesia, bikin alat digital yang gampang dipakai siapa aja.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#produk" class="rounded-[10px] bg-accent px-5.5 py-3.5 text-[15px] font-semibold text-bg hover:opacity-90"
            >Lihat produk</a
          >
          <a href="#custom" class="rounded-[10px] border border-field px-5.5 py-3.5 text-[15px] hover:border-accent"
            >Punya ide sendiri?</a
          >
        </div>
      </section>

      <section id="produk" class="flex scroll-mt-6 flex-col gap-6 pb-24">
        <h2 class="font-display text-[32px] font-bold tracking-[-0.02em]">Produk</h2>
        <div class="grid gap-5 md:grid-cols-2">
          {
            availableProducts.map((product) => (
              <article class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-line bg-card transition-colors focus-within:border-accent hover:border-field">
                <img
                  src={product.image}
                  alt={product.imageAlt}
                  width="1120"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[8/5] w-full border-b border-line bg-bg object-cover"
                />
                <div class="flex flex-1 flex-col items-start gap-3 px-5 py-6 sm:p-7">
                  <span class="rounded-full bg-accent px-2.5 py-1 text-sm font-semibold text-bg">
                    Udah bisa dipakai
                  </span>
                  <h3 class="font-display text-2xl font-bold">{product.name}</h3>
                  <p class="mb-2 leading-relaxed text-muted">{product.text}</p>
                  <a
                    href={product.href}
                    aria-label={`${product.cta}: ${product.name}`}
                    class="mt-auto inline-flex min-h-11 items-center rounded-lg border border-field px-4 text-sm font-semibold text-accent hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    {product.cta}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {
            productIdeas.map((product) => (
              <article class="flex flex-col gap-3 rounded-2xl border border-line bg-card p-5 sm:p-7">
                <span class="self-start rounded-full border border-field px-2.5 py-0.5 text-sm text-faint">
                  Masih ide
                </span>
                <h3 class="font-display text-xl font-bold">{product.name}</h3>
                <p class="leading-relaxed text-muted">{product.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        id="custom"
        class="mx-auto mb-6 flex max-w-[760px] scroll-mt-6 flex-col gap-8 rounded-[20px] border border-line bg-card px-5 py-8 sm:p-14"
      >
        <div class="flex flex-col items-center gap-2.5 text-center">
          <h2 class="font-display text-[clamp(30px,4vw,44px)] leading-[1.1] font-bold tracking-[-0.02em]">
            Punya <span class="rounded-lg bg-accent px-2.5 text-bg">ide sendiri?</span>
          </h2>
          <p class="text-[17px] text-muted">Ada ide? Tulis dulu aja sini.</p>
        </div>
        <form data-form="/api/idea" class="flex flex-col gap-7">
          <div class="grid grid-cols-[36px_minmax(0,1fr)] items-start gap-4">
            <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-accent font-bold text-bg">1</span>
            <label class="flex flex-col gap-2">
              <span class="text-[17px] font-semibold">Ide kamu</span>
              <span class="text-sm leading-normal text-muted">Ceritain aja pakai bahasa sehari-hari, gak usah rapi.</span>
              <textarea
                name="idea"
                required
                maxlength="5000"
                rows="5"
                placeholder="Misal: aplikasi kasir buat warung kopi, bisa catat stok dan laporan harian"
                class:list={[field, 'resize-y']}></textarea>
            </label>
          </div>
          <div class="grid grid-cols-[36px_minmax(0,1fr)] items-start gap-4">
            <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-accent font-bold text-bg">2</span>
            <label class="flex flex-col gap-2">
              <span class="text-[17px] font-semibold"
                >Nama kamu <span class="text-sm font-normal text-faint">(boleh dikosongin)</span></span
              >
              <span class="text-sm leading-normal text-muted">Biar tau harus manggil kamu apa.</span>
              <input name="name" type="text" maxlength="200" autocomplete="name" placeholder="Nama kamu" class={field} />
            </label>
          </div>
          <div class="grid grid-cols-[36px_minmax(0,1fr)] items-start gap-4">
            <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-accent font-bold text-bg">3</span>
            <label class="flex flex-col gap-2">
              <span class="text-[17px] font-semibold">WhatsApp atau email</span>
              <span class="text-sm leading-normal text-muted">Buat ngabarin kamu soal idenya. Gak bakal disebar.</span>
              <input
                name="contact"
                type="text"
                required
                maxlength="200"
                placeholder="0812... atau email@kamu.com"
                class={field}
              />
            </label>
          </div>
          <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button
            type="submit"
            class="h-14 rounded-xl bg-accent text-[17px] font-bold text-bg hover:opacity-90 disabled:opacity-60"
            >Kirim ide</button
          >
          <p data-status class="-mt-3 text-center text-sm text-faint" aria-live="polite">
            Nanti kamu dihubungi lewat kontak di atas.
          </p>
        </form>
        <p class="text-center text-sm text-muted">
          Mau ngobrol langsung? Kenalan dulu di
          <a href="https://jabbar-hafizh.github.io/" class="text-accent hover:underline">jabbar-hafizh.github.io</a>
        </p>
      </section>

      <section
        id="kabar"
        class="mb-18 flex flex-wrap items-center justify-between gap-6 rounded-[20px] border border-line bg-card px-5 py-10 sm:p-14"
      >
        <div class="flex max-w-[460px] flex-col gap-2">
          <h2 class="font-display text-[28px] font-bold">Mau jadi yang pertama coba?</h2>
          <p data-status class="text-[15px] text-muted" aria-live="polite">
            Satu email tiap ada produk baru. Gak ada spam.
          </p>
        </div>
        <form data-form="/api/subscribe" class="flex w-full flex-wrap gap-2 sm:w-auto">
          <label for="email" class="sr-only">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="email@kamu.com"
            class="h-12 min-w-0 flex-1 rounded-[10px] border border-field bg-bg px-4 text-[15px] placeholder:text-faint focus:border-accent focus:outline-none sm:min-w-[240px]"
          />
          <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button
            type="submit"
            class="h-12 rounded-[10px] bg-accent px-5 text-[15px] font-semibold text-bg hover:opacity-90 disabled:opacity-60"
            >Kabarin ya</button
          >
        </form>
      </section>

      <footer class="flex flex-wrap justify-between gap-4 border-t border-line pt-7 pb-10 text-[13px] text-faint">
        <span
          >© 2026 Altivola, dibikin oleh <a href="https://jabbar-hafizh.github.io/" class="hover:text-accent"
            >Abdul Jabbar Hafizh</a
          ></span
        >
        <a href="https://github.com/altivola" class="hover:text-accent">github.com/altivola</a>
      </footer>
    </div>

    <script>
      // Both forms post JSON to the Worker and show the result in their [data-status] line.
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) {
        const status = form.closest('section')?.querySelector<HTMLElement>('[data-status]')
        const button = form.querySelector('button')
        form.addEventListener('submit', async (e) => {
          e.preventDefault()
          if (button) button.disabled = true
          try {
            const res = await fetch(form.dataset.form ?? '', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(Object.fromEntries(new FormData(form))),
            })
            const data = (await res.json().catch(() => ({}))) as { error?: string }
            if (!res.ok) throw new Error(data.error ?? 'Gagal kirim, coba lagi ya.')
            form.reset()
            if (status) {
              status.textContent =
                form.dataset.form === '/api/idea'
                  ? 'Makasih! Idenya udah masuk, nanti kamu dihubungi ya.'
                  : 'Sip, nanti dikabarin pas ada produk baru.'
              status.style.color = 'var(--color-accent)'
            }
          } catch (err) {
            if (status) {
              status.textContent = err instanceof Error ? err.message : 'Gagal kirim, coba lagi ya.'
              status.style.color = '#f87171'
            }
          } finally {
            if (button) button.disabled = false
          }
        })
      }
    </script>
  </body>
</html>
