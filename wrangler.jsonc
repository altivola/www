{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Lives at https://www.altivola.workers.dev
  "name": "www",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The Astro build is plain static files. The Worker only handles the two forms.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "www",
      "database_id": "0f1dc614-2111-4dc5-a040-c9a9edbfb37c",
      "migrations_dir": "migrations"
    }
  ]
}
